{
  "name": "yaml-regex-highlighting",
  "displayName": "YAML RegEx Highlighting",
  "description": "YAML RegEx Highlighting for Visual Studio Code",
  "version": "1.0.0",
  "publisher": "cielquan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cielquan/krys-colors"
  },
  "scripts": {
    "build": "../../scripts/check-and-build-grammar.mjs syntaxes/yaml-regexp.tmLanguage.yaml",
    "watch": "watchexec -W syntaxes/yaml-regexp.tmLanguage.yaml pnpm build"
  },
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Programming Languages",
    "Language Packs"
  ],
  "contributes": {
    "grammars": [
      {
        "path": "./syntaxes/yaml-regexp.tmLanguage.json",
        "scopeName": "source.regexp.yaml",
        "injectTo": [
          "source.yaml"
        ]
      }
    ]
  }
}
