{
  "name": "gitignore-syntax-vsx",
  "displayName": "GitIgnore Syntax",
  "description": "GitIgnore Syntax for Visual Studio Code",
  "version": "1.0.3",
  "publisher": "cielquan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cielquan/krys-colors"
  },
  "scripts": {
    "build": "../../scripts/check-and-build-grammar.mjs syntaxes/ignore.tmLanguage.yaml",
    "watch": "watchexec -W syntaxes/ignore.tmLanguage.yaml pnpm build"
  },
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Programming Languages",
    "Language Packs"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ignore",
        "extensions": [
          ".gitignore"
        ],
        "configuration": "./language-configuration/ignore.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ignore",
        "scopeName": "source.ignore",
        "path": "./syntaxes/ignore.tmLanguage.json"
      }
    ]
  }
}
