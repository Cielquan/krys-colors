{
  "comments": {
    "lineComment": { "comment": "#" }
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "r\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "&\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "^\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "$\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "%\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "r'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "&'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "^'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "$'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "%'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`" }
  ],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:func|class|var|get|set|static|async|if|elif|else|match|for|while).*?:\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*(?:return|continue|break|pass).*$",
      "action": { "indent": "outdent" }
    },
    {
      "previousLineText": "^\\s*##\\s*$",
      "beforeText": "^\\s*##\\s*$",
      "action": { "indent": "none" }
    },
    {
      "beforeText": "^\\s*##.*$",
      "action": {
        "indent": "none",
        "appendText": "## "
      }
    }
  ]
}
