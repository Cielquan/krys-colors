// https://github.com/MagicStack/MagicPython/blob/master/misc/scopes
{
  "$schema": "vscode://schemas/color-theme",
  "name": "Krys Colors",
  "type": "dark",
  "colors": {
    "activityBar.background": "#272822",
    "activityBar.foreground": "#f8f8f2",
    "badge.background": "#75715e",
    "badge.foreground": "#f8f8f2",
    "button.background": "#75715e",
    "debugToolBar.background": "#1e1f1c",
    "diffEditor.insertedTextBackground": "#4b661680", // middle of #272822 and #a6e22e
    "diffEditor.removedTextBackground": "#90274a70", // middle of #272822 and #f92672
    "dropdown.background": "#414339",
    "dropdown.listBackground": "#1e1f1c",
    "editor.background": "#000000",
    "editor.foreground": "#f8f8f2",
    "editor.lineHighlightBackground": "#3e3d32",
    "editor.selectionBackground": "#f9267270",
    "editor.selectionHighlightBackground": "#f9267240",
    "editor.selectionHighlightBorder": "#f9267270",
    "editor.wordHighlightBackground": "#4a4a7680",
    "editor.wordHighlightStrongBackground": "#6a6a9680",
    "editorBracketHighlight.foreground1": "#e86233",
    "editorBracketPairGuide.background1": "#e86233",
    "editorBracketPairGuide.activeBackground1": "#e86233",
    "editorBracketHighlight.foreground2": "#6f84ff",
    "editorBracketPairGuide.background2": "#6f84ff",
    "editorBracketPairGuide.activeBackground2": "#6f84ff",
    "editorBracketHighlight.foreground3": "#e8ba36",
    "editorBracketPairGuide.background3": "#e8ba36",
    "editorBracketPairGuide.activeBackground3": "#e8ba36",
    "editorBracketHighlight.foreground4": "#cd1cef",
    "editorBracketPairGuide.background4": "#cd1cef",
    "editorBracketPairGuide.activeBackground4": "#cd1cef",
    "editorBracketHighlight.foreground5": "#54a857",
    "editorBracketPairGuide.background5": "#54a857",
    "editorBracketPairGuide.activeBackground5": "#54a857",
    "editorBracketHighlight.unexpectedBracket.foreground": "#f92672",
    "editorCursor.foreground": "#f8f8f0",
    "editorGroup.border": "#34352f",
    "editorGroup.dropBackground": "#41433980",
    "editorGroupHeader.tabsBackground": "#1e1f1c",
    "editorHoverWidget.background": "#414339",
    "editorHoverWidget.border": "#75715e",
    "editorHoverWidget.highlightForeground": "#a7ff95",
    "editorIndentGuide.background1": "#ffff4050",
    "editorIndentGuide.activeBackground1": "#ffff4080",
    "editorIndentGuide.background2": "#7fff7f50",
    "editorIndentGuide.activeBackground2": "#7fff7f80",
    "editorIndentGuide.background3": "#ff7fff50",
    "editorIndentGuide.activeBackground3": "#ff7fff80",
    "editorIndentGuide.background4": "#4fecec50",
    "editorIndentGuide.activeBackground4": "#4fecec80",
    "editorIndentGuide.background5": "#464646",
    "editorIndentGuide.activeBackground5": "#767676",
    "editorLineNumber.activeForeground": "#c2c2bf",
    "editorLineNumber.foreground": "#90908a",
    "editorSuggestWidget.background": "#272822",
    "editorSuggestWidget.border": "#75715e",
    "editorWhitespace.foreground": "#464741",
    "editorWidget.background": "#1e1f1c",
    "focusBorder": "#75715e",
    "input.background": "#414339",
    "inputOption.activeBorder": "#75715e",
    "inputValidation.errorBackground": "#90274a", // middle of #272822 and #f92672
    "inputValidation.errorBorder": "#f92672",
    "inputValidation.infoBackground": "#546190", // middle of #272822 and #819aff
    "inputValidation.infoBorder": "#819aff",
    "inputValidation.warningBackground": "#848528", // middle of #272822 and #e2e22e
    "inputValidation.warningBorder": "#e2e22e",
    "list.activeSelectionBackground": "#75715e",
    "list.dropBackground": "#414339",
    "list.focusBackground": "#414339",
    "list.highlightForeground": "#f8f8f2",
    "list.hoverBackground": "#3e3d32",
    "list.inactiveSelectionBackground": "#414339",
    "menu.background": "#1e1f1c",
    "menu.foreground": "#cccccc",
    "minimap.selectionHighlight": "#878b9180",
    "panel.border": "#414339",
    "panelTitle.activeForeground": "#f8f8f2",
    "panelTitle.activeBorder": "#75715e",
    "panelTitle.inactiveForeground": "#75715e",
    "peekView.border": "#75715e",
    "peekViewEditor.background": "#272822",
    "peekViewEditor.matchHighlightBackground": "#75715e",
    "peekViewResult.background": "#1e1f1c",
    "peekViewResult.matchHighlightBackground": "#75715e",
    "peekViewResult.selectionBackground": "#414339",
    "peekViewTitle.background": "#1e1f1c",
    "pickerGroup.foreground": "#75715e",
    "progressBar.background": "#75715e",
    "selection.background": "#ccccc7",
    "settings.numberInputBackground": "#32342d",
    "settings.textInputBackground": "#32342d",
    "sideBar.background": "#1e1f1c",
    "sideBarSectionHeader.background": "#272822",
    "statusBar.background": "#414339",
    "statusBar.noFolderBackground": "#414339",
    "statusBar.debuggingBackground": "#75715e",
    "statusBarItem.remoteBackground": "#ac6218",
    "tab.border": "#1e1f1c",
    "tab.inactiveBackground": "#34352f",
    "tab.inactiveForeground": "#ccccc7", // needs to be bright so it's readable when another editor group is focused
    "terminal.ansiBlack": "#333333",
    "terminal.ansiBrightBlack": "#666666",
    "terminal.ansiBlue": "#6a7ec8",
    "terminal.ansiBrightBlue": "#819aff", // hue shifted #ae81ff
    "terminal.ansiCyan": "#56adbc",
    "terminal.ansiBrightCyan": "#66d9ef",
    "terminal.ansiGreen": "#86b42b",
    "terminal.ansiBrightGreen": "#a6e22e",
    "terminal.ansiMagenta": "#8c6bc8",
    "terminal.ansiBrightMagenta": "#ae81ff",
    "terminal.ansiRed": "#c4265e", // the bright color with ~75% transparent on the background
    "terminal.ansiBrightRed": "#f92672",
    "terminal.ansiYellow": "#b3b42b",
    "terminal.ansiBrightYellow": "#e2e22e", // hue shifted #a6e22e
    "terminal.ansiWhite": "#e3e3dd",
    "terminal.ansiBrightWhite": "#f8f8f2",
    "titleBar.activeBackground": "#1e1f1c",
    "widget.shadow": "#000000",
  },
  "tokenColors": [
    ////////////////////////////////////////
    ////////////////////////////////////////
    ////////////////////////////////////////
    //// GLOBAL DEFAULTS
    ////////////////////////////////////////
    ////////////////////////////////////////
    ////////////////////////////////////////
    {
      "scope": [
        "source",
        "punctuation.separator",
        // "punctuation.separator.period",
        // "punctuation.separator.comma",
        // "punctuation.separator.arguments",
        // "punctuation.separator.parameter",
        // "punctuation.separator.parameters",
        // "punctuation.separator.element",
        // "punctuation.separator.list",
        // "punctuation.separator.mapping", // ',' in yaml mapping
        // "punctuation.separator.sequence", // ',' in yaml array
        // "punctuation.separator.array", // ',' in JSON array
        "punctuation.accessor",
        // "punctuation.accessor.ts", // .
        // "punctuation.accessor.optional.ts", // ?.
        "punctuation.definition.tag",
      ],
      "settings": {
        "foreground": "#f8f8f2",
      },
    },
    {
      "scope": [
        "punctuation.section",

        "punctuation.separator.key-value",
        "punctuation.separator.dictionary.key-value",
        "punctuation.separator.dict",

        "punctuation.separator.annotation",
        "punctuation.separator.colon.python", // ':' after type annotions in body
        "punctuation.separator.annotation.result",
        "storage.type.function.arrow",

        "punctuation.separator.slice.python", // slice operator ':'
        "punctuation.separator.statement.and.shell.dockerfile", // &&

        "punctuation.separator.continuation.line", // e.g. '\' at end of line in python
        "constant.character.escape.double-quoted.newline.yaml",
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#f92672",
      },
    },
    {
      "name": "Variable",
      "scope": ["variable"],
      "settings": {
        "foreground": "#f8f8f2",
      },
    },
    {
      "name": "Constant",
      "scope": ["variable.other.constant", "variable.other.enummember", "constant.other.caps"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f8f8f2",
      },
    },
    {
      "name": "Built-in constant",
      "scope": ["constant.other.builtin", "support.constant"],
      "settings": {
        "fontStyle": "italic bold",
        "foreground": "#f8f8f2",
      },
    },
    {
      "name": "Language/Numeric constant",
      "scope": ["constant.language"],
      "settings": {
        "fontStyle": "italic bold",
        "foreground": "#859900",
      },
    },
    {
      "name": "String",
      "scope": ["string"],
      "settings": {
        "foreground": "#e6db74",
      },
    },
    {
      "name": "Byte-String",
      "scope": ["string.quoted.binary", "string.quoted.raw.binary"],
      "settings": {
        "foreground": "#a5c261",
      },
    },
    {
      "name": "Path",
      "scope": [
        "source.ignore",
        "string.node-path.quoted.multi.gdscript",
        "string.node-path.quoted.single.gdscript",
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a5c261",
      },
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.format",
        "punctuation.definition.interpolation",
        "punctuation.definition.template-expression.begin.tsx",
        "punctuation.definition.template-expression.end.tsx",
        "meta.interpolation",
      ],
      "settings": {
        "foreground": "#ae81ff",
      },
    },
    {
      "name": "User-defined constant",
      "scope": ["constant.character", "constant.other"],
      "settings": {
        "foreground": "#ae81ff",
      },
    },
    {
      "name": "Number",
      "scope": ["constant.numeric", "punctuation.separator.dot.decimal"],
      "settings": {
        "foreground": "#ae81ff",
      },
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",

        "constant.language.import-export-all", // * in import
        "keyword.other.unit.percentage.css", // %
        "punctuation.definition.directive.begin.yaml", // %
        "constant.language.merge.yaml", // <<
        "punctuation.definition.lifetime.rust", // '
        "punctuation.definition.decorator.python", // @
        "punctuation.definition.negation.ignore", // !
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#f92672",
      },
    },
    {
      "name": "Operator (logical)",
      "scope": [
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "keyword.operator.boolean",
        "keyword.operator.membership",
        "keyword.operator.wordlike.logical",
        "keyword.operator.wordlike.comparison",
        "keyword.operator.wordlike.boolean",
        "keyword.operator.wordlike.membership",
      ],
      "settings": {
        "foreground": "#268bd2",
      },
    },
    {
      "name": "Keyword",
      "scope": ["keyword.other"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#66d9ef",
      },
    },
    {
      "name": "Keyword (control)",
      "scope": ["keyword.control"],
      "settings": {
        "fontStyle": "italic bold",
        "foreground": "#66d9ef",
      },
    },
    {
      "name": "Keyword (import)",
      "scope": ["keyword.control.import", "keyword.control.from"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a6e22e",
      },
    },
    {
      "name": "Keyword (special)",
      "scope": [
        "keyword.other.important.css",
        "keyword.operator.new.js",
        "keyword.operator.new.jsx",
        "keyword.operator.new.ts",
        "keyword.operator.new.tsx",
        "meta.other.directive.restructuredtext",
        "entity.name.role.restructuredtext",
      ],
      "settings": {
        "foreground": "#f92672",
      },
    },
    {
      "name": "Storage modifier",
      "scope": ["storage.modifier", "storage.type.function.async", "storage.type.format"],
      "settings": {
        "fontStyle": "",
        "foreground": "#f92672",
      },
    },
    {
      "name": "Storage type",
      "scope": ["storage.type"],
      "settings": {
        "foreground": "#66d9ef",
      },
    },
    {
      "name": "Storage type (special)",
      "scope": [
        "storage.type.string",
        "storage.modifier.string",
        "string.quoted.byte.raw.rust", // b and r in front of string or char
        "punctuation.definition.string.raw.rust", // # for raw strings
        "punctuation.definition.node-reference.gdscript", // $ for node shorthand
        "punctuation.definition.node-reference.unique.gdscript", // % for unique node shorthand
        "storage.type.number",
        "storage.type.imaginary.number",
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#66d9ef",
      },
    },
    {
      "name": "Storage type (class/func)",
      "scope": [
        "storage.type.class",
        "storage.type.function",
        "storage.type.signal",
        "keyword.other.fn",
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#66d9ef",
      },
    },
    {
      "name": "Library class/type",
      "scope": [
        "support.type",
        "entity.name.type.numeric",
        "entity.name.type.primitive",
        "entity.name.type.option",
        "entity.name.type.result",
        "entity.name.type.void",
        "entity.name.type.instance.jsdoc",
        "fenced_code.block.language.markdown",
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#268bd2",
      },
    },
    {
      "name": "Class name",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.trait",
        "entity.name.type.declaration",
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#a6e22e",
      },
    },
    {
      "name": "Built-in Class/Enum",
      "scope": [
        "support.class",
        "support.enum",
        "entity.name.class.builtin",
        "entity.name.type.class.builtin",
        "entity.name.type.enum.builtin",
        "entity.name.type.struct.builtin",
        "entity.name.type.trait.builtin",
        "entity.name.type.declaration.builtin",
      ],
      "settings": {
        "fontStyle": "italic underline",
        "foreground": "#a6e22e",
      },
    },
    {
      "name": "Inherited class",
      "scope": ["entity.other.inherited-class"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a6e22e",
      },
    },
    {
      "name": "Self",
      "scope": ["variable.language", "variable.parameter.function.language.special"],
      "settings": {
        "fontStyle": "",
        "foreground": "#94558d",
      },
    },
    {
      "name": "Library function",
      "scope": ["support.function"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#66d9ef",
      },
    },
    {
      "name": "Function name (definition)",
      "scope": [
        "entity.name.function",
        "entity.name.function.definition",
        "entity.name.signal.gdscript",
        "variable.other.jinja.filter",
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#a6e22e",
      },
    },
    {
      "name": "Function parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#fd971f",
      },
    },
    {
      "name": "Function name (call)",
      "scope": ["entity.name.function.call", "meta.function-call.generic.python"],
      "settings": {
        "foreground": "#66d9ef",
      },
    },
    {
      "name": "Function argument",
      "scope": [
        "variable.argument",
        "variable.parameter.function.call",
        "variable.parameter.function-call",
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#cb4b16",
      },
    },
    {
      "name": "Namespace/Scope",
      "scope": ["entity.name.namespace", "entity.name.scope-resolution"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a7ff95",
      },
    },
    {
      "name": "Tag name",
      "scope": ["entity.name.tag"],
      "settings": {
        "fontStyle": "",
        "foreground": "#f92672",
      },
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "fontStyle": "",
        "foreground": "#a6e22e",
      },
    },
    {
      "name": "Comment",
      "scope": ["comment"],
      "settings": {
        "foreground": "#75715e",
      },
    },
    {
      "name": "Comment (documentation)",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring",
      ],
      "settings": {
        "foreground": "#629755",
      },
    },
    {
      "name": "Comment (region)",
      "scope": ["comment.block.region", "comment.line.region"],
      "settings": {
        "foreground": "#ad75c4",
      },
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "keyword.illegal"],
      "settings": {
        "fontStyle": "bold italic underline",
        "foreground": "#ff0000",
      },
    },
    {
      "scope": ["token.info-token"],
      "settings": {
        "foreground": "#6796e6",
      },
    },
    {
      "scope": ["token.warn-token"],
      "settings": {
        "foreground": "#cd9731",
      },
    },
    {
      "scope": ["token.error-token"],
      "settings": {
        "foreground": "#f44747",
      },
    },
    {
      "scope": ["token.debug-token"],
      "settings": {
        "foreground": "#b267e6",
      },
    },
    {
      "name": "diff.header",
      "scope": ["meta.diff", "meta.diff.header"],
      "settings": {
        "foreground": "#75715e",
      },
    },
    {
      "name": "diff.deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#f92672",
      },
    },
    {
      "name": "diff.inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#a6e22e",
      },
    },
    {
      "name": "diff.changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#e6db74",
      },
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#ae81ff",
      },
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#66d9ef",
      },
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#66d9ef",
      },
    },
    {
      "scope": ["markup.underline"],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#66d9ef",
      },
    },
    {
      "scope": ["markup.strikethrough"],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#66d9ef",
      },
    },
    {
      "scope": ["markup.quote", "markup.other.command", "string.other.interpreted"],
      "settings": {
        "foreground": "#6d6d94",
      },
    },
    {
      "scope": ["markup.underline.link"],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#e6db74",
      },
    },
    {
      "scope": ["string.other.link"],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#fd971f",
      },
    },
    {
      "scope": ["markup.raw", "markup.inline.raw"],
      "settings": {
        "foreground": "#82a363",
      },
    },
    {
      "scope": [
        "markup.raw.inner",
        "markup.raw.block",
        "markup.fenced_code",
        "punctuation.section.raw",
      ],
      "settings": {
        "foreground": "#4f7e4e",
      },
    },
    {
      "scope": ["markup.list"],
      "settings": {
        "foreground": "#a6e22e",
      },
    },
    {
      "scope": ["markup.other.tag"],
      "settings": {
        "foreground": "#66d9ef",
      },
    },
    ////////////////////////////////////////
    //// Config files
    ////////////////////////////////////////
    {
      "name": "Config section",
      // INI / TOML
      "scope": ["entity.name.section.group-title", "variable.key.table"],
      "settings": {
        "foreground": "#268bd2",
      },
    },
    {
      "name": "Config array",
      // TOML
      "scope": ["variable.key.array"],
      "settings": {
        "foreground": "#2fa9ff",
      },
    },
    {
      "name": "Config key",
      // INI / TOML / YAML / JSON
      "scope": [
        "keyword.other.definition.ini",
        "keyword.key.toml",
        "variable.key.toml",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
      ],
      "settings": {
        "foreground": "#a6e22e",
      },
    },
    {
      "name": "Config built-in constant",
      // TOML / YAML / JSON
      "scope": [
        "constant.other.boolean.toml",
        "constant.language.boolean.toml",
        "constant.language.boolean.yaml",
        "constant.language.json",
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#66d9ef",
      },
    },
    {
      "name": "Config date",
      // TOML / YAML
      "scope": [
        "constant.other.datetime-with-timezone.toml",
        "constant.other.datetime.toml",
        "constant.other.date.toml",
        "constant.other.time.datetime.offset.toml",
        "constant.other.time.datetime.local.toml",
        "constant.other.time.date.toml",
        "constant.other.time.time.toml",
        "constant.other.timestamp.yaml",
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#66d9ef",
      },
    },
    {
      "name": "Config string",
      // INI / TOML / YAML / JSON
      "scope": [
        "string.quoted.double.ini", // quoted string double
        "string.quoted.single.ini", // quoted string single
        "source.ini", // rest of ini // missing scope for property value in ini ???

        "string.quoted.triple.basic.block.toml", // triple "
        "string.quoted.single.basic.line.toml", // single "

        "string.unquoted.plain.in.yaml", // unquoted string in []
        "string.unquoted.plain.out.yaml", // unquoted string
        "string.unquoted.block.yaml", // unquoted string block
        "string.quoted.double.yaml", // "" string

        "string.quoted.double.json", // quoted string
      ],
      "settings": {
        "foreground": "#2aa198",
      },
    },
    {
      "name": "Config string (literal)",
      // TOML / YAML
      "scope": [
        "string.quoted.triple.literal.block.toml", // triple '
        "string.quoted.single.literal.line.toml", // single '
        "string.quoted.single.yaml", // '' string (literal)
      ],
      "settings": {
        "foreground": "#e6db74",
      },
    },
    ////////////////////////////////////////
    //// Log files
    ////////////////////////////////////////
    {
      "name": "Log Trace",
      "scope": ["log.trace"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#66d9ef",
      },
    },
    {
      "name": "Log Debug",
      "scope": ["log.debug", "log.verbose"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#268bd2",
      },
    },
    {
      "name": "Log Info",
      "scope": ["log.info"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#a6e22e",
      },
    },
    {
      "name": "Log Warning",
      "scope": ["log.warning"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#fd971f",
      },
    },
    {
      "name": "Log Error",
      "scope": ["log.error", "log.exception"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f92672",
      },
    },
    {
      "name": "Log Exceptiontype",
      "scope": ["log.exceptiontype"],
      "settings": {
        "foreground": "#ae81ff",
      },
    },
    {
      "name": "Log Date",
      "scope": ["log.date"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#66d9ef",
      },
    },
    ////////////////////////////////////////
    //// Special colored
    ////////////////////////////////////////
    {
      // TESTING SCOPE
      "scope": ["a"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff00d4",
      },
    },
    {
      // Special syntax which needs a visual warning
      "scope": ["storage.modifier.unsafe.rust"],
      "settings": {
        "foreground": "#f92672",
        "fontStyle": "bold",
      },
    },
    {
      "scope": [
        "keyword.operator.access.dot.rust", // .
        "string.regexp",
      ],
      "settings": {
        "foreground": "#f8f8f2",
      },
    },
    {
      "scope": [
        "entity.other.jinja.delimiter", // variable and tag
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#f92672",
      },
    },
    {
      "scope": [
        "constant.other.ellipsis.python",
        "support.variable.magic.python",
        "meta.separator.markdown", // *** --- ___
        "entity.other.document.begin.yaml", // beginnging ---
        "entity.other.document.end.yaml", // ending ...
        "support.other.escape.special.regexp",
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#268bd2",
      },
    },
    {
      "scope": ["keyword.other.crate.rust"],
      "settings": {
        "foreground": "#94558d",
      },
    },
    {
      "scope": [
        "punctuation.definition.metadata.markdown",
        "punctuation.definition.link.title.begin.markdown",
        "punctuation.definition.link.title.end.markdown",
      ],
      "settings": {
        "foreground": "#e6db74",
      },
    },
    {
      "scope": [
        "constant.character.set.regexp", // inside []
        "constant.other.character-class.member.ignore", // inside []
        "constant.other.brace-expansion.member.ignore", // inside {}
      ],
      "settings": {
        "foreground": "#fd971f",
      },
    },
    {
      "scope": [
        "keyword.operator.borrow.and.rust", // &
        "punctuation.definition.anchor.yaml", // &
        "punctuation.definition.alias.yaml", // *
        "support.other.match.begin.regexp", // begin '^'
        "support.other.match.end.regexp", // end '$'
        "storage.modifier.annotation.gdscript", // @... annotations
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#fd971f",
      },
    },
    {
      "scope": [
        "entity.name.type.anchor.yaml",
        "variable.other.alias.yaml",
        "variable.other.assignment.dockerfile",
        "variable.other.dockerfile",
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e8bf6a",
      },
    },
    {
      "scope": ["keyword.operator.quantifier.regexp"],
      "settings": {
        "foreground": "#ae81ff",
      },
    },
    {
      "scope": [
        "entity.name.type.lifetime.rust", // 'LIFETIMENAME
        "support.function.magic.python", // magic func assignment
        "support.function.virtual.gdscript",
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#b200b2",
      },
    },
    {
      "scope": [
        "entity.name.command.shell.dockerfile", // shell cmd e.g. grep
      ],
      "settings": {
        "foreground": "#66d9ef",
      },
    },
    {
      "scope": ["storage.type.function.lambda.python"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a6e22e",
      },
    },
    {
      "scope": [
        "meta.attribute.rust", // attribute stuff
        "entity.name.image.dockerfile", // image
        "entity.name.image.stage.dockerfile",
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#cb4b16",
      },
    },
    {
      "scope": [
        "entity.name.type.rust", // all remaining types
        "entity.name.type.ts", // all remaining types
        "entity.name.type.tsx", // all remaining types
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#a6e22e",
      },
    },
    {
      "scope": [
        "meta.literal.node-reference.gdscript",
        "meta.literal.node-reference.bare.gdscript",
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#63c259",
      },
    },
  ],
  ////////////////////////////////////////
  ////////////////////////////////////////
  ////////////////////////////////////////
  //// SEMANTIC HIGHLIGHTING
  ////////////////////////////////////////
  ////////////////////////////////////////
  ////////////////////////////////////////
  "semanticHighlighting": true,
  "semanticTokenColors": {
    ////////////////////////////////////////
    //// Defaults
    ////////////////////////////////////////
    "*.documentation": {
      "foreground": "#629755",
    },
    "module": {
      "foreground": "#f8f8f2",
      "fontStyle": "",
    },
    "class": {
      "foreground": "#66d9ef",
      "fontStyle": "",
    },
    "class.declaration": {
      "foreground": "#a6e22e",
      "fontStyle": "underline bold",
    },
    "method": {
      "foreground": "#66d9ef",
      "fontStyle": "",
    },
    "method.declaration": {
      "foreground": "#a6e22e",
      "fontStyle": "bold",
    },
    "function": {
      "foreground": "#66d9ef",
      "fontStyle": "",
    },
    "function.declaration": {
      "foreground": "#a6e22e",
      "fontStyle": "bold",
    },
    "macro": {
      "foreground": "#66d9ef",
      "fontStyle": "",
    },
    "macro.declaration": {
      "foreground": "#a6e22e",
      "fontStyle": "bold",
    },
    "parameter": {
      "foreground": "#fd971f",
      "fontStyle": "italic",
    },
    "variable.readonly": {
      "foreground": "#f8f8f2",
      "fontStyle": "bold",
    },
    "typeParameter.declaration": {
      "foreground": "#a6e22e",
      "fontStyle": "underline",
    },
    "struct.declaration": {
      "foreground": "#a6e22e",
      "fontStyle": "underline",
    },
    "enum.declaration": {
      "foreground": "#a6e22e",
      "fontStyle": "underline",
    },
    "formatSpecifier": {
      "foreground": "#ae81ff",
    },
    ////////////////////////////////////////
    //// JavaScript
    ////////////////////////////////////////
    "class.defaultLibrary:javascript": {
      "foreground": "#268bd2",
      "fontStyle": "italic",
    },
    ////////////////////////////////////////
    //// Rust
    ////////////////////////////////////////
    "*.attribute:rust": {
      "foreground": "#aa4926",
      "fontStyle": "italic",
    },
    "lifetime:rust": {
      "foreground": "#b200b2",
    },
    "boolean:rust": {
      "foreground": "#859900",
    },
    "variable.constant:rust": {
      "foreground": "#f8f8f2",
      "fontStyle": "bold",
    },
    "keyword.controlFlow:rust": {
      "foreground": "#66d9ef",
      "fontStyle": "italic bold",
    },
    "union.declaration:rust": {
      "foreground": "#a6e22e",
      "fontStyle": "underline",
    },
    "arithmetic.mutable:rust": {
      "foreground": "#f92672",
    },
    ////////////////////////////////////////
    //// Python
    ////////////////////////////////////////
    // https://github.com/microsoft/pylance-release#semantic-highlighting
    "*.typeHint:python": {
      "foreground": "#89ffa6",
      "fontStyle": "italic",
    },
    "*.typeHintComment:python": {
      "foreground": "#75715e",
      "fontStyle": "",
    },
    "class.builtin:python": {
      "foreground": "#268bd2",
      "fontStyle": "italic",
    },
    "class.typeHint:python": {
      "foreground": "#89ffa6",
      "fontStyle": "italic",
    },
    "selfParameter:python": {
      "foreground": "#94558d",
      "fontStyle": "",
    },
    "clsParameter:python": {
      "foreground": "#94558d",
      "fontStyle": "",
    },
    "magicFunction.declaration:python": {
      "foreground": "#b200b2",
      "fontStyle": "italic",
    },
    "magicFunction.builtin:python": {
      "foreground": "#b200b2",
      "fontStyle": "italic",
    },
    "function.builtin:python": {
      "foreground": "#66d9ef",
      "fontStyle": "italic",
    },
    "*.decorator:python": {
      "foreground": "#66d9ef",
    },
    "function.typeHint:python": {
      "foreground": "#89ffa6",
      // "foreground": "#a7ff95", // old
      "fontStyle": "italic",
    },
    "member:python": {
      "foreground": "#f8f8f2",
      "fontStyle": "",
    },
    "intrinsic:python": {
      "foreground": "#66d9ef",
      "fontStyle": "italic",
    },
    ////////////////////////////////////////
    //// TOML
    ////////////////////////////////////////
    "tomlTableKey": {
      "foreground": "#268bd2",
      "fontStyle": "italic",
    },
    "tomlArrayKey": {
      "foreground": "#2fa9ff",
      "fontStyle": "italic",
    },
  },
}
