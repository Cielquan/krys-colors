{
  "name": "krys-colors",
  "displayName": "Krys Colors",
  "description": "Krys theme for Visual Studio Code based on Monokai",
  "version": "1.0.1",
  "publisher": "cielquan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cielquan/krys-colors"
  },
  "scripts": {
    "build-theme": "../../scripts/jsonc-to-json.mjs themes/KrysColors.colorTheme.jsonc",
    "build-grammars": "../../scripts/check-and-build-grammar.mjs syntaxes",
    "build": "pnpm build-theme; pnpm build-grammars",
    "watch": "watchexec -e jsonc,yaml -W themes/ -W syntaxes/ pnpm build"
  },
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Krys Colors",
        "uiTheme": "vs-dark",
        "path": "./themes/KrysColors.colorTheme.json"
      }
    ],
    "grammars": [
      {
        "path": "./syntaxes/python.async.tmLanguage.json",
        "scopeName": "source.fix.async.python",
        "injectTo": [
          "source.python"
        ]
      },
      {
        "path": "./syntaxes/python.percent-format.tmLanguage.json",
        "scopeName": "source.fix.percent-format.python",
        "injectTo": [
          "source.python"
        ]
      },
      {
        "path": "./syntaxes/python.string-line-continuation.tmLanguage.json",
        "scopeName": "source.fix.string-line-continuation.python",
        "injectTo": [
          "source.python"
        ]
      },
      {
        "path": "./syntaxes/rust.tmLanguage.json",
        "scopeName": "source.fix.rust",
        "injectTo": [
          "source.rust"
        ]
      }
    ]
  }
}
