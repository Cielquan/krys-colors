{
  "name": "krys-colors",
  "displayName": "Krys Colors",
  "description": "Krys theme for Visual Studio Code based on Monokai",
  "version": "1.0.1",
  "publisher": "cielquan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cielquan/krys-colors"
  },
  "scripts": {
    "build": "../../scripts/jsonc-to-json.mjs themes/KrysColors.colorTheme.jsonc",
    "watch": "watchexec -w themes/KrysColors.colorTheme.jsonc pnpm build"
  },
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Krys Colors",
        "uiTheme": "vs-dark",
        "path": "./themes/KrysColors.colorTheme.json"
      }
    ],
    "grammars": [
      {
        "path": "./syntaxes/gdscript.tmLanguage.json",
        "scopeName": "source.fix.gdscript",
        "injectTo": [
          "source.gdscript"
        ]
      },
      {
        "path": "./syntaxes/python.tmLanguage.json",
        "scopeName": "source.fix.python",
        "injectTo": [
          "source.python"
        ]
      },
      {
        "path": "./syntaxes/rust.tmLanguage.json",
        "scopeName": "source.fix.rust",
        "injectTo": [
          "source.rust"
        ]
      }
    ]
  }
}
